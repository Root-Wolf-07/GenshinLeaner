# Environment Configuration Example for AI Study Companion

# App Settings
APP_NAME="AI Study Companion"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="generate-a-secure-32-byte-hex-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://127.0.0.1:5500","http://127.0.0.1:8000"]

# Database
DATABASE_URL="sqlite:///./storage/ai_study_companion.db"
# For PostgreSQL in production:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/ai_study_companion"

# Storage Paths
UPLOAD_DIR="./storage/uploads"
VECTOR_INDEX_DIR="./storage/indexes"
MAX_UPLOAD_SIZE_MB=50

# LLM Providers Configuration
DEFAULT_LLM_PROVIDER="gemini" # options: "gemini", "openai", "ollama", "mock"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# OpenAI-Compatible Provider (Optional)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Ollama Local LLM (Optional)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Embeddings & RAG Settings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_TOKENS=4000

# Voice & Character Tutor Settings
TTS_PROVIDER="mock" # options: "mock", "edge_tts", "openai", "gemini"
STT_PROVIDER="mock" # options: "mock", "openai", "gemini"
AUDIO_DIR="./storage/audio"
MAX_AUDIO_UPLOAD_SIZE_MB=25
AUDIO_RETENTION_HOURS=24
SPEECH_GENERATION_TIMEOUT_SECONDS=30
ANIMATION_INTENSITY_DEFAULT=0.8
ENABLE_GAMIFICATION=true
NEUTRAL_MODE_DEFAULT=false
OPENAI_TTS_VOICE="alloy"
OPENAI_TTS_MODEL="tts-1"
OPENAI_STT_MODEL="whisper-1"

# Student Authentication, Identity & Security Policies
VERIFICATION_CODE_EXPIRE_MINUTES=10
RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRE_MINUTES=15
SESSION_REMEMBER_ME_DAYS=30

# External Delivery Providers (Optional: defaults to dev mock in DEBUG mode)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="admissions@teyvat.edu"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

